# Copia este archivo como .env y llena tus credenciales del sandbox de Factus.
# El .env NUNCA se sube a git (está en .gitignore).

NODE_ENV=development
PORT=3000

FACTUS_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=

# Opcional: id del rango de numeración (si solo hay uno activo, Factus lo usa solo)
# FACTUS_NUMBERING_RANGE_ID=389

# Factus Pay (recaudo): credenciales PROPIAS, distintas a las de facturación
FACTUS_PAY_BASE_URL=https://pay-api-sandbox.factus.com.co
FACTUS_PAY_EMAIL=
FACTUS_PAY_PASSWORD=
# Llave del webhook (la misma que registras en el panel de Factus Pay). Mínimo 16 caracteres.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
FACTUS_PAY_WEBHOOK_KEY=
# Vigencia del QR de cada recaudo en segundos (86400 = 24 h)
RECAUDO_EXPIRACION_SEG=86400

# Tarifa Afinia (COP por kWh)
AFINIA_TARIFA_KWH=1033

# Precio instalado por kWp (COP), para estimar el valor del proyecto
PRECIO_KWP_COP=4200000
